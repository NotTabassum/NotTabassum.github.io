---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Experience from "../components/Experience.astro";
import Projects from "../components/Projects.astro";
import CompetitiveProgramming from "../components/CompetitiveProgramming.astro";
import Skills from "../components/Skills.astro";
import Education from "../components/Education.astro";
import Hobbies from "../components/Hobbies.astro";
import Contact from "../components/Contact.astro";
import profile from "../data/profile";

const title = `${profile.name} · Backend Software Engineer`;
---
<Base title={title} description={`${profile.headline}. ${profile.pitch}`}>
  <Hero />
  <Experience />
  <Projects />
  <CompetitiveProgramming />
  <Skills />
  <Education />
  <Hobbies />
  <Contact />
</Base>
