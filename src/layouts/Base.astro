---
import "../styles/global.css";
import ThemeToggle from "../components/ThemeToggle.astro";
import profile from "../data/profile";

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const nav = [
  ["experience", "Experience"],
  ["projects", "Projects"],
  ["cp", "CP"],
  ["education", "Education"],
  ["hobby", "Hobby"],
  ["contact", "Contact"],
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f1faee" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1a2332" media="(prefers-color-scheme: dark)" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Source+Code+Pro:wght@400;500&family=Source+Sans+3:ital,wght@0,400;0,600;0,700;1,400&family=Source+Serif+4:opsz,wght@8..60,400;8..60,500;8..60,600&display=swap"
    />
    <script is:inline>
      // Follows the system theme by default. A manual toggle lasts only for this tab's session.
      try { localStorage.removeItem("theme"); var t = sessionStorage.getItem("theme"); if (t === "light" || t === "dark") document.documentElement.setAttribute("data-theme", t); } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="topbar">
      <div class="container topbar-inner">
        <a class="brand" href="#top" translate="no">{profile.name}</a>
        <nav id="site-nav" aria-label="Sections">
          {nav.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}
        </nav>
        <ThemeToggle />
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Menu">
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path class="bars" d="M4 7h16M4 12h16M4 17h16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><path class="cross" d="M6 6l12 12M18 6 6 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
        </button>
      </div>
    </header>
    <script is:inline>
      // Phones: the section links open from the menu button and close again once one is picked.
      (function () {
        var bar = document.querySelector(".topbar"), btn = bar.querySelector(".menu-toggle");
        function set(open) { bar.toggleAttribute("data-open", open); btn.setAttribute("aria-expanded", String(open)); }
        btn.addEventListener("click", function () { set(!bar.hasAttribute("data-open")); });
        bar.querySelectorAll("nav a").forEach(function (a) { a.addEventListener("click", function () { set(false); }); });
        document.addEventListener("keydown", function (e) { if (e.key === "Escape") set(false); });
      })();
    </script>
    <main id="main">
      <slot />
    </main>
  </body>
</html>

<style>
  .topbar {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
  }
  .topbar-inner {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    min-height: 4rem;
  }
  .brand {
    font-family: var(--font-display);
    font-size: 1.3rem;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  nav {
    display: flex;
    gap: 1.75rem;
    margin-left: auto;
    overflow-x: auto;
    scrollbar-width: none;
    font-size: 0.95rem;
    font-weight: 400;
  }
  nav::-webkit-scrollbar { display: none; }
  nav a {
    color: var(--muted);
    white-space: nowrap;
    padding-block: 0.25rem;
    transition: color 0.15s var(--ease-out);
  }
  nav a:hover { color: var(--text); }

  .menu-toggle {
    display: none;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    margin-right: -0.5rem;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--text);
    cursor: pointer;
  }
  .menu-toggle .cross, .topbar[data-open] .menu-toggle .bars { display: none; }
  .topbar[data-open] .menu-toggle .cross { display: inline; }

  /* Phones and small tablets, where the links don't fit beside the name: they drop down from a menu button. */
  @media (max-width: 767px) {
    .topbar-inner { gap: 0.25rem; }
    .topbar-inner :global(.theme-toggle) { margin-left: auto; }
    .menu-toggle { display: inline-grid; }
    nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      gap: 0;
      margin: 0;
      padding: 0.25rem 16px 0.75rem;
      background: var(--bg);
      border-bottom: 1px solid var(--border);
      font-size: 1.05rem;
    }
    .topbar[data-open] nav { display: flex; }
    nav a { padding-block: 0.8rem; border-bottom: 1px solid var(--border); color: var(--text); }
    nav a:last-child { border-bottom: 0; }
  }
</style>
