---
import Section from "./Section.astro";
import Figure from "./Figure.astro";
import profile from "../data/profile";
import { formatMonth } from "../lib/format";

// The finishing month, or just the year when only that is known.
const finished = (end: string) => (end.length === 4 ? end : formatMonth(end));
const photo = profile.education.find((e) => e.photo)?.photo;
---
<Section id="education" label="Education">
  <div class:list={["layout", { "has-photo": photo }]}>
    <ol class="list">
      {profile.education.map((e) => (
        <li>
          <span class="year label">{finished(e.end)}</span>
          <div>
            <h3>{e.schoolUrl ? <a href={e.schoolUrl} rel="noopener noreferrer" target="_blank">{e.school}</a> : e.school}</h3>
            <p class="degree">{e.degree}</p>
          </div>
        </li>
      ))}
    </ol>
    {photo && (
      <Figure photo={photo} sizes="(min-width: 860px) 20rem, 92vw" ratio="4 / 3" class="grad" />
    )}
  </div>
</Section>

<style>
  .layout { display: grid; gap: 2rem; }
  @media (min-width: 860px) {
    .has-photo { grid-template-columns: minmax(0, 1fr) 20rem; column-gap: clamp(2.5rem, 5vw, 4.5rem); align-items: stretch; }
    /* The photo stretches to the list's height, so their bottom edges line up. */
    .has-photo :global(.grad) { display: flex; flex-direction: column; height: 100%; }
    .has-photo :global(.grad > img), .has-photo :global(.grad > .frame) { flex: 1; aspect-ratio: auto; height: 100%; }
  }
  .list { list-style: none; padding: 0; margin: 0; }
  li {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: 1.25rem;
    align-items: baseline;
    padding: 1rem 0;
    border-bottom: 1px solid var(--border);
  }
  li:first-child { padding-top: 0; }
  h3 { font-size: 1.3rem; }
  h3 a { transition: color 0.15s var(--ease-out); }
  h3 a:hover { color: var(--accent); }
  .degree { margin: 0.25rem 0 0; color: var(--muted); }
</style>
