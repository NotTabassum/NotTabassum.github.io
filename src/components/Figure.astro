---
import { Image } from "astro:assets";
import type { PhotoSlot } from "../data/types";
import { photoAsset } from "../lib/photos";

interface Props {
  photo: PhotoSlot;
  /** Rendered width hint for the browser, e.g. "(min-width: 960px) 40rem, 92vw". */
  sizes: string;
  /** Frame shape, e.g. "16 / 9". */
  ratio?: string;
  /** Names the event when the photo has no caption of its own. */
  caption?: string;
  class?: string;
}
const { photo, sizes, ratio = "4 / 3", class: cls } = Astro.props;
const caption = photo.caption ?? Astro.props.caption;
---
<figure class:list={["fig", cls]} style={`--ratio: ${ratio}`}>
  {"file" in photo ? (
    <Fragment>
      <Image
        class:list={{ "light-only": photo.dark }}
        src={photoAsset(photo.file)}
        alt={photo.alt}
        widths={[320, 480, 640, 960, 1280]}
        sizes={sizes}
        loading="lazy"
        decoding="async"
      />
      {photo.dark && (
        <Image
          class="dark-only"
          src={photoAsset(photo.dark)}
          alt={photo.alt}
          widths={[320, 480, 640, 960, 1280]}
          sizes={sizes}
          loading="lazy"
          decoding="async"
        />
      )}
    </Fragment>
  ) : (
    <div class="frame">
      <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true">
        <path d="M4 7.5h3l1.5-2h7l1.5 2h3v11H4z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
        <circle cx="12" cy="13" r="3.5" fill="none" stroke="currentColor" stroke-width="1.6" />
      </svg>
      <span>Photo coming soon</span>
    </div>
  )}
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .fig { margin: 0; }
  img, .frame {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: var(--ratio);
    object-fit: cover;
    background: var(--surface);
  }
  /* A photo with a dark version shows the one matching the theme; the hidden one is never downloaded. */
  .dark-only { display: none; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .light-only { display: none; }
    :global(:root:not([data-theme="light"])) .dark-only { display: block; }
  }
  :global(:root[data-theme="dark"]) .light-only { display: none; }
  :global(:root[data-theme="dark"]) .dark-only { display: block; }
  .frame {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.4rem;
    border: 2px dashed var(--line);
    color: var(--muted);
    font-size: 0.8rem;
  }
  .frame svg { color: var(--line); }
  figcaption {
    margin-top: 0.5rem;
    padding-top: 0.4rem;
    border-top: 2px solid var(--line);
    font-size: 0.85rem;
    color: var(--muted);
  }
</style>
