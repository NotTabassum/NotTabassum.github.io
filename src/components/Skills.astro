---
import Section from "./Section.astro";
import profile from "../data/profile";
---
<Section id="skills" label="Skills">
  <ul class="groups">
    {profile.skills.map((g) => (
      <li class="group">
        <h3>{g.group}</h3>
        {/* Each item keeps its separator, so a line never starts with "·". */}
        <p class="items">{g.items.map((item, i) => <span>{item}{i < g.items.length - 1 && " ·"}</span>)}</p>
      </li>
    ))}
  </ul>
</Section>

<style>
  .groups {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
    gap: 1rem;
  }
  .group {
    display: grid;
    align-content: start;
    gap: 0.9rem;
    padding: 1.25rem;
    background: var(--surface);
    border-top: 2px solid var(--line);
  }
  h3 { font-size: 1.2rem; }
  .items { margin: 0; line-height: 1.7; color: var(--muted); display: flex; flex-wrap: wrap; column-gap: 0.3em; }
  .items span { white-space: nowrap; }
</style>
