---
import Section from "./Section.astro";
import Figure from "./Figure.astro";
import profile from "../data/profile";


const number = (i: number) => String(i + 1).padStart(2, "0");
---
<Section id="projects" label="Projects" tone="tint">
  <ol class="rows">
    {profile.projects.map((p, i) => (
      <li class:list={["row", { flip: i % 2 === 1 }]}>
        <div class="media">
          <Figure photo={p.photo ?? { pending: true }} sizes="(min-width: 860px) 36rem, 92vw" ratio="16 / 10" />
        </div>
        <div class="info">
          <p class="label">{number(i)} · {p.kind}</p>
          <h3 translate="no">{p.name}</h3>
          <p class="summary">{p.summary}</p>
          <dl class="facts">
            {p.status && (
              <div>
                <dt>Status</dt>
                <dd><span class:list={["dot", { live: p.status.startsWith("Live") }]} aria-hidden="true"></span>{p.status}</dd>
              </div>
            )}
            <div>
              <dt>Runs on</dt>
              <dd>{p.runsOn}</dd>
            </div>
            <div>
              <dt>Stack</dt>
              <dd>{p.stack.join(" · ")}</dd>
            </div>
            {p.tools && (
              <div>
                <dt>Tools</dt>
                <dd>{p.tools.join(" · ")}</dd>
              </div>
            )}
          </dl>
          <p class="links">
            {p.links.map((l) => <a class="link" href={l.url} rel="noopener noreferrer" target="_blank">{l.label} <span class="arrow" aria-hidden="true">↗</span></a>)}
          </p>
        </div>
      </li>
    ))}
  </ol>
</Section>

<style>
  .rows { list-style: none; padding: 0; margin: 0; display: grid; gap: clamp(3.5rem, 8vw, 6rem); }
  .row { display: grid; gap: 1.75rem; }
  .media {
    background: var(--surface);
    padding: clamp(1rem, 3vw, 2.25rem);
  }
  .info { min-width: 0; }
  h3 {
    margin-top: 0.5rem;
    font-size: clamp(1.75rem, 3.4vw, 2.4rem);
    letter-spacing: -0.015em;
  }
  .summary { margin: 0.9rem 0 1.25rem; max-width: 34rem; }
  .facts {
    display: grid;
    gap: 0.5rem;
    margin: 0 0 1.25rem;
    font-size: 0.95rem;
  }
  .facts div { display: grid; grid-template-columns: 5.5rem minmax(0, 1fr); gap: 1rem; }
  .facts dt { color: var(--muted); }
  .facts dd { margin: 0; }
  .dot {
    display: inline-block;
    width: 0.5rem;
    height: 0.5rem;
    margin-right: 0.45rem;
    border-radius: 50%;
    background: #e0a526;
    vertical-align: 0.1em;
  }
  /* Teal when live, amber otherwise (in progress). */
  .dot.live { background: var(--line); }
  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.25rem;
    margin: 0;
    font-size: 0.95rem;
  }

  /* Wide screens: media and text side by side, switching sides on every other row. */
  @media (min-width: 860px) {
    .row {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      column-gap: clamp(2.5rem, 5vw, 4.5rem);
      align-items: center;
    }
    .flip .media { order: 2; }
  }
</style>
