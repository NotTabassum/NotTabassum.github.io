---
import profile from "../data/profile";
---
<header class="hero" id="top">
  <p class="prompt mono" aria-hidden="true"><span class="accent">$</span> whoami</p>
  <h1>{profile.name}</h1>
  <p class="headline mono">{profile.headline}<span class="caret" aria-hidden="true"></span></p>
  <p class="pitch">{profile.pitch}</p>
  <p class="location muted mono">📍 {profile.location}</p>
  <ul class="links">
    <li><a href={`mailto:${profile.email}`}>{profile.email}</a></li>
    {profile.links.map((l) => <li><a href={l.url} rel="me noopener">{l.label}</a></li>)}
  </ul>
</header>

<style>
  .hero { padding-block: 4rem 1rem; }
  .prompt { margin: 0 0 0.75rem; color: var(--muted); font-size: 0.9rem; }
  .accent { color: var(--accent); }
  h1 {
    font-size: clamp(2.25rem, 7vw, 3.5rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0;
  }
  .headline { margin: 0.75rem 0 0; font-size: clamp(0.9rem, 2.6vw, 1.05rem); color: var(--text); }
  .caret {
    display: inline-block;
    width: 0.55em;
    height: 1.1em;
    margin-left: 0.25em;
    vertical-align: -0.2em;
    background: var(--accent);
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink { 50% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .caret { animation: none; } }
  .pitch { font-size: 1.15rem; max-width: 36rem; margin: 1.5rem 0 0.5rem; }
  .location { font-size: 0.85rem; margin: 0; }
  .links {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .links a {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    padding: 0.35rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    background: var(--surface);
    color: var(--text);
  }
  .links a:hover { border-color: var(--accent); color: var(--accent); text-decoration: none; }
</style>
