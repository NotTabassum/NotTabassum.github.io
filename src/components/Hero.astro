---
import { Image } from "astro:assets";
import profile from "../data/profile";
import { photoAsset } from "../lib/photos";

const photo = profile.photo;
const initials = profile.name.split(/\s+/).map((w) => w[0]).join("");
const [job] = profile.experience;
const [school] = profile.education;
const github = profile.links.find((l) => l.label === "GitHub");
const linkedin = profile.links.find((l) => l.label === "LinkedIn");
const [codeforces, codechef] = profile.cp.ratings;

// Short facts under the intro, all read from the data.
const facts = [
  { label: "Work", value: `${job.role}, ${job.company}` },
  // Short form, e.g. "BSc. in CSE, RUET": the degree's field as initials, the school by its acronym.
  { label: "Graduation", value: `${school.degree.replace(/^(\w+) in (.+)$/, (_, d, f) => `${d}. in ${f.match(/[A-Z]/g).join("")}`)}, ${school.school.match(/\((\w+)\)/)?.[1] ?? school.school}` },
  { label: codeforces.site, value: `${codeforces.title}, max ${codeforces.maxRating}` },
  { label: codechef.site, value: `${codechef.title}, max ${codechef.maxRating}` },
];
---
<header class="hero container" id="top">
  <div class="hero-grid">
    <div class="intro">
      <p class="label rise" style="--i:0">{profile.location} · {job.role.replace(/\s*\(.*\)/, "")} at {job.company}</p>
      <h1 class="rise" style="--i:1">I’m {profile.name}, {profile.lead}</h1>
      <p class="pitch rise" style="--i:2">{profile.pitch}</p>
      <div class="actions rise" style="--i:3">
        <a class="action" href="#projects">View projects</a>
        {profile.cv && (
          <a class="action" href={profile.cv} download>Download CV</a>
        )}
        <span class="divider" aria-hidden="true"></span>
        {github && (
          <a class="icon" href={github.url} rel="me noopener noreferrer" target="_blank" aria-label="GitHub">
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.34 1.08 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02a9.56 9.56 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.69-4.57 4.93.36.31.68.92.68 1.85v2.75c0 .27.18.58.69.48A10 10 0 0 0 12 2Z"/></svg>
          </a>
        )}
        {linkedin && (
          <a class="icon" href={linkedin.url} rel="me noopener noreferrer" target="_blank" aria-label="LinkedIn">
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><rect x="3" y="3" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M8 10.5V17M8 7.25v.01M12 17v-6.5M12 13.5a2.75 2.75 0 0 1 5.5 0V17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
          </a>
        )}
      </div>
    </div>
    <figure class="portrait rise" style="--i:2">
      {photo ? (
        <Image
          src={photoAsset(photo.file)}
          alt={photo.alt}
          widths={[280, 420, 560, 840]}
          sizes="(min-width: 860px) 18rem, 11rem"
          loading="eager"
          fetchpriority="high"
        />
      ) : (
        <div class="monogram" aria-hidden="true">{initials}</div>
      )}
    </figure>
  </div>

  <dl class="facts rise" style="--i:4">
    {facts.map((f) => (
      <div>
        <dt class="label">{f.label}</dt>
        <dd>{f.value}</dd>
      </div>
    ))}
  </dl>
</header>

<style>
  .hero { padding-block: clamp(3rem, 8vw, 6rem) 0; }
  .hero-grid {
    display: flex;
    flex-direction: column-reverse;
    align-items: flex-start;
    gap: 2rem;
  }
  .intro { min-width: 0; }
  .intro > .label { margin: 0 0 1.25rem; }
  h1 {
    max-width: 22ch;
    font-size: clamp(2.1rem, 4.4vw, 3.25rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }
  .pitch {
    max-width: 34rem;
    margin: 1.5rem 0 0;
    font-size: 1.1rem;
    color: var(--muted);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    margin-top: 2rem;
  }
  /* Text actions: no box, just teal text, underlined on hover. */
  .action {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--accent);
    font-size: 1.05rem;
    font-weight: 600;
    text-underline-offset: 0.3em;
  }
  .action:hover { text-decoration: underline; }
  .divider { width: 1px; height: 1.5rem; background: var(--border); }
  .icon {
    display: inline-grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    color: var(--muted);
    transition: color 0.15s var(--ease-out);
  }
  .icon:hover { color: var(--accent); }

  .portrait {
    position: relative;
    isolation: isolate;
    width: min(11rem, 45vw);
    margin: 0;
  }
  .portrait::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    transform: translate(0.75rem, 0.75rem);
    background: var(--chip-bg);
  }
  .portrait :global(img), .monogram {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }
  /* Stands in for the portrait until profile.photo is set. */
  .monogram {
    display: grid;
    place-items: center;
    background: var(--surface);
    border: 1px solid var(--line);
    color: var(--accent);
    font-family: var(--font-display);
    font-size: clamp(3rem, 7vw, 5rem);
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem 2rem;
    margin: clamp(3rem, 6vw, 4.5rem) 0 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }
  .facts dd { margin: 0.35rem 0 0; font-weight: 600; }

  @media (min-width: 860px) {
    .hero-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 18rem;
      column-gap: clamp(2.5rem, 6vw, 5rem);
      align-items: center;
    }
    .portrait { width: 100%; justify-self: end; }
    .portrait::before { transform: translate(1rem, 1rem); }
    .facts { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
</style>
