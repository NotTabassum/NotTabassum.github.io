---
interface Props {
  id: string;
  label: string;
}
const { id, label } = Astro.props;
---
<section id={id} aria-labelledby={`${id}-h`} class="section">
  <h2 id={`${id}-h`} class="section-label"><span aria-hidden="true">// </span>{label}</h2>
  <slot />
</section>

<style>
  .section {
    padding-block: 3rem 1rem;
    scroll-margin-top: 4rem;
  }
  .section-label {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    text-transform: lowercase;
    color: var(--accent);
    margin: 0 0 1.5rem;
  }
  .section-label span {
    color: var(--muted);
  }
</style>
