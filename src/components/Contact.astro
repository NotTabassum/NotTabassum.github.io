---
import Section from "./Section.astro";
import profile from "../data/profile";
import { formatMonth } from "../lib/format";
import { formatPhone, gmailCompose, whatsappUrl } from "../lib/contact";

// Profiles, each with the handle it goes to.
const channels = profile.links.map((l) => ({ ...l, handle: new URL(l.url).pathname.split("/").filter(Boolean).pop() ?? l.url }));
---
<Section id="contact" label="Contact" tone="tint">
  <div class="layout">
    <div class="primary">
      <p class="lead">Open to backend engineering opportunities, technical collaborations, and problem setting or testing for programming contests.</p>
      <div class="email-row">
        <a class="email" href={gmailCompose(profile.email)} rel="noopener noreferrer" target="_blank">{profile.email}<span class="arrow" aria-hidden="true">↗</span></a>
        <button class="copy" type="button" data-copy={profile.email} aria-label="Copy email address" title="Copy email address">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><rect x="8" y="8" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M16 8V4H4v12h4" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>
        </button>
        <span class="copied" role="status" aria-live="polite"></span>
      </div>
      {profile.whatsapp && (
        <div class="phone-row">
          <span class="label">WhatsApp</span>
          <a class="link" href={whatsappUrl(profile.whatsapp)} rel="noopener noreferrer" target="_blank">{formatPhone(profile.whatsapp)}<span class="arrow" aria-hidden="true">↗</span></a>
          <button class="copy small" type="button" data-copy={profile.whatsapp} aria-label="Copy phone number" title="Copy phone number">
            <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><rect x="8" y="8" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M16 8V4H4v12h4" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>
          </button>
          <span class="copied" role="status" aria-live="polite"></span>
        </div>
      )}
    </div>
    <dl class="channels">
      {channels.map((c) => (
        <div>
          <dt class="label">{c.label}</dt>
          <dd><a class="link" href={c.url} rel="me noopener noreferrer" target="_blank">{c.handle}<span class="arrow" aria-hidden="true">↗</span></a></dd>
        </div>
      ))}
    </dl>
  </div>
</Section>
<footer class="container">
  <div class="footer">
    <span>© {profile.updated.slice(0, 4)} <span translate="no">{profile.name}</span></span>
    <span>Last updated <time datetime={profile.updated}>{formatMonth(profile.updated.slice(0, 7))}</time></span>
  </div>
</footer>

<script is:inline>
  document.querySelectorAll("button[data-copy]").forEach(function (btn) {
    var status = btn.parentElement.querySelector(".copied");
    btn.addEventListener("click", function () {
      var done = function () {
        status.textContent = "Copied";
        setTimeout(function () { status.textContent = ""; }, 1800);
      };
      if (navigator.clipboard) navigator.clipboard.writeText(btn.dataset.copy).then(done, function () { status.textContent = "Press Ctrl+C to copy"; });
    });
  });
</script>

<style>
  .lead {
    max-width: 42rem;
    margin: 0 0 1.25rem;
    font-size: clamp(1.05rem, 1.8vw, 1.25rem);
  }
  .email {
    display: inline-block;
    max-width: 100%;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.6vw, 1.65rem);
    letter-spacing: -0.015em;
    line-height: 1.1;
    overflow-wrap: anywhere;
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.15em;
    transition: text-decoration-thickness 0.15s var(--ease-out);
  }
  .email:hover { text-decoration-thickness: 4px; }
  .email-row { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 0.75rem; }
  .copy {
    display: inline-grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    transition: color 0.15s var(--ease-out), transform 0.12s var(--ease-out);
  }
  .copy:hover { color: var(--accent); }
  /* With a mouse, the copy button shows only while hovering its line (or when focused); touch screens always show it. */
  @media (hover: hover) {
    .copy { opacity: 0; transition: opacity 0.15s var(--ease-out), color 0.15s var(--ease-out), transform 0.12s var(--ease-out); }
    .email-row:hover .copy, .phone-row:hover .copy, .copy:focus-visible { opacity: 1; }
  }
  .copy:active { transform: scale(0.95); }
  .copied { font-size: 0.85rem; color: var(--accent); }
  .email .arrow { margin-left: 0.12em; font-size: 0.8em; }
  .layout { display: grid; gap: 2.5rem; }
  .channels { margin: 0; border-top: 1px solid var(--border); }
  .channels div {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    gap: 1rem;
    align-items: baseline;
    padding: 0.8rem 0;
    border-bottom: 1px solid var(--border);
  }
  .channels dd { margin: 0; overflow-wrap: anywhere; }
  .channels .arrow { margin-left: 0.2em; }
  .phone-row { display: flex; flex-wrap: wrap; align-items: center; gap: 0.25rem 0.75rem; margin-top: 0.75rem; }
  .phone-row .link { color: var(--accent); }
  .phone-row .arrow { margin-left: 0.2em; }
  .copy.small { width: 2rem; height: 2rem; }
  /* Wide screens: the message and email on the left, the other channels on the right. */
  @media (min-width: 860px) {
    .layout { grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); column-gap: clamp(2.5rem, 6vw, 5rem); align-items: start; }
  }
  .footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-block: 1.25rem 2.5rem;
    border-top: 2px solid var(--rule);
    font-size: 0.8rem;
    color: var(--muted);
  }
</style>
