---
import Section from "./Section.astro";
import profile from "../data/profile";

// One line icon per hobby, drawn in the theme's teal; matched by title, decorative only.
const icons: Record<string, string> = {
  "Classical Dance": `<circle cx="12" cy="4.5" r="2"/><path d="M12 7v6m0 0-4 7m4-7 4 7M6 9.5c2.5 1 9.5 1 12 0"/><path d="M8.5 20h-2m11 0h-2"/>`,
  Running: `<circle cx="14.5" cy="4.5" r="2"/><path d="m9 21 3-6 3 2.5V21M6.5 12.5l3-4.5h4l2.5 3.5 3 .5M13.5 8 11 13"/>`,
  "Travel & Adventure": `<path d="M3 18c2 0 2-1.5 4.5-1.5S9.5 18 12 18s2.5-1.5 4.5-1.5S19 18 21 18"/><path d="M12 3a6 6 0 0 1 6 6H6a6 6 0 0 1 6-6Zm0 6v6"/>`,
};
---
<Section id="hobby" label="Hobby">
  <ul class="hobbies">
    {profile.hobbies.map((h) => (
      <li class="hobby">
        <svg viewBox="0 0 24 24" width="32" height="32" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={icons[h.title] ?? ""} />
        <h3>{h.title}</h3>
        <p>{h.text}</p>
      </li>
    ))}
  </ul>
</Section>

<style>
  .hobbies {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: 1rem;
  }
  .hobby {
    display: grid;
    align-content: start;
    gap: 0.6rem;
    padding: 1.5rem;
    background: var(--surface);
  }
  svg { color: var(--line); }
  h3 { font-size: 1.35rem; }
  p { margin: 0; color: var(--muted); }
</style>
